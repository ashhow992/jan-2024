digraph G { graph [rankdir=TB, bgcolor=white]; node [fontname="Arial",fontsize=11,shape=box]; edge [fontname="Arial",fontsize=10]; start [shape=oval,label="Start"]; id [shape=parallelogram,label="Input player ID"]; valid [shape=diamond,label="Non-blank?"]; games [shape=parallelogram,label="Input games (validated integer 5–10)"]; init [label="Empty records; game = 1"]; loop [shape=diamond,label="game <= games?"]; score [shape=parallelogram,label="Input validated score (integer >= 0)"]; time [shape=parallelogram,label="Input validated minutes (integer 5–60)"]; add [label="Append score and minutes; game = game + 1"]; calc [label="Find maximum score; sum minutes;\nround average to nearest whole minute"]; display [shape=parallelogram,label="Display ID, highest, average"]; save [label="Attempt append of all data to text file"]; ok [shape=diamond,label="Saved?"]; yes [shape=parallelogram,label="Display saved message"]; no [shape=parallelogram,label="Display file error"]; end [shape=oval,label="End"]; start->id->valid; valid->id [label="No"]; valid->games [label="Yes"]; games->init->loop; loop->score [label="Yes"]; score->time->add->loop; loop->calc [label="No"]; calc->display->save->ok; ok->yes [label="Yes"]; ok->no [label="No"]; yes->end; no->end; }